<% content_for :title, "Team" %>
<div class="mx-auto max-w-6xl px-4 pt-8 sm:px-6">
  <% if session[:admin_email] %>
    <p class="text-right text-xs text-muted">Signed in as <%= session[:admin_email] %> · <%= link_to "Sign out", admin_sign_out_path, class: "underline" %></p>
  <% end %>
  <h1 class="font-display text-3xl font-extrabold">Where shoppers want JeeSauce</h1>
  <p class="mt-1 text-muted">Last <%= Admin::DashboardController::DAYS %> days. Places are rounded to about 7 miles; nothing identifies a shopper.</p>

  <dl class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-5">
    <% [ [ "Searches", @search_count ], [ "Came up empty", @empty_count ], [ "Asked a store", @asks.sum(&:last) ],
         [ "Sightings", @sightings ], [ "Shares (all time)", @shares ] ].each do |label, n| %>
      <div class="rounded-2xl bg-white p-4 shadow-sm">
        <dt class="text-xs font-semibold tracking-wide text-muted uppercase"><%= label %></dt>
        <dd class="font-display text-3xl font-extrabold tabular-nums"><%= number_with_delimiter(n) %></dd>
      </div>
    <% end %>
  </dl>
  <p class="mt-3 text-sm">
    <%= link_to "Photos to approve (#{@pending_photos})", admin_sightings_path, class: "font-semibold underline underline-offset-2" %> ·
    <%= link_to "Download demand CSV", admin_demand_path(format: :csv), class: "font-semibold underline underline-offset-2" %>
  </p>

  <% if maps_key && @demand.any? %>
    <div class="mt-6 h-[28rem] overflow-hidden rounded-2xl bg-line" data-controller="demand-map"
         data-demand-map-places-value="<%= @demand.map { |d| d.merge(lat: d[:lat].to_f, lng: d[:lng].to_f) }.select { |d| d[:lat].nonzero? }.to_json %>"></div>
    <p class="mt-2 text-xs text-muted">Circle size: searches. Red: searches with no store within <%= Store::DEFAULT_RADIUS_MILES %> miles. Teal: found a store.</p>
  <% end %>

  <div class="mt-8 grid gap-8 lg:grid-cols-[2fr_1fr]">
    <section>
      <h2 class="font-display text-xl font-bold">Busiest places with no store nearby</h2>
      <table class="mt-3 w-full text-left text-sm">
        <thead class="text-xs text-muted uppercase"><tr><th class="py-1">Place</th><th>Searches</th><th>Empty</th><th>Nearest store</th></tr></thead>
        <tbody>
          <% @demand.first(40).each do |d| %>
            <tr class="border-t border-line">
              <td class="py-1.5"><%= [ d[:zip], d[:state] ].compact.join(" ").presence || "near" %> <span class="text-muted"><%= d[:lat] %>, <%= d[:lng] %></span></td>
              <td class="tabular-nums"><%= d[:total] %></td>
              <td class="tabular-nums <%= "font-bold text-red-700" if d[:empty].positive? %>"><%= d[:empty] %></td>
              <td class="tabular-nums"><%= d[:nearest_miles] ? "#{d[:nearest_miles]} mi" : "–" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </section>
    <section>
      <h2 class="font-display text-xl font-bold">Flavors people filter for</h2>
      <ul class="mt-3 text-sm"><% @flavor_counts.each do |name, n| %><li class="flex justify-between border-t border-line py-1.5"><span><%= name %></span><span class="tabular-nums"><%= n %></span></li><% end %></ul>
      <h2 class="mt-8 font-display text-xl font-bold">Store asks, by chain</h2>
      <ul class="mt-3 text-sm"><% @asks.each do |chain, n| %><li class="flex justify-between border-t border-line py-1.5"><span><%= Retailer::REQUESTS.dig(chain, :name) || "In person / other" %></span><span class="tabular-nums"><%= n %></span></li><% end %></ul>
      <h2 class="mt-8 font-display text-xl font-bold">Store asks, by ZIP</h2>
      <ul class="mt-3 text-sm"><% @ask_places.each do |zip, n| %><li class="flex justify-between border-t border-line py-1.5"><span><%= zip %></span><span class="tabular-nums"><%= n %></span></li><% end %></ul>
    </section>
  </div>

  <div class="mt-10 grid gap-8 lg:grid-cols-3">
    <section>
      <h2 class="font-display text-xl font-bold">Buy clicks</h2>
      <p class="mt-1 text-sm text-muted">Clicks out from the finder, last <%= Admin::DashboardController::DAYS %> days.</p>
      <ul class="mt-3 text-sm"><% @clicks.each do |(kind, target), n| %><li class="flex justify-between border-t border-line py-1.5"><span><%= target %> <span class="text-muted"><%= kind %></span></span><span class="tabular-nums"><%= n %></span></li><% end %></ul>
      <h3 class="mt-6 font-semibold">jeesauce.com clicks by spot</h3>
      <ul class="mt-2 text-sm"><% @dtc_spots.each do |spot, n| %><li class="flex justify-between border-t border-line py-1.5"><span><%= spot || "–" %></span><span class="tabular-nums"><%= n %></span></li><% end %></ul>
      <p class="mt-2 text-xs text-muted">Orders from these show in Shopify under UTM source “findjeesauce”.</p>
    </section>
    <section>
      <h2 class="font-display text-xl font-bold">“Buy at H-E-B” by store</h2>
      <p class="mt-1 text-sm text-muted">To compare with H-E-B's eCom sales per store (Circana).</p>
      <ul class="mt-3 text-sm"><% @heb_clicks.each do |rep_id, n| %><li class="flex justify-between border-t border-line py-1.5"><span><%= @heb_stores[rep_id]&.name || "Store #{rep_id}" %></span><span class="tabular-nums"><%= n %></span></li><% end %></ul>
    </section>
    <section>
      <h2 class="font-display text-xl font-bold">Shares and opens</h2>
      <p class="mt-1 text-sm text-muted">Sent by channel, and how many friends opened the link (all time).</p>
      <table class="mt-3 w-full text-left text-sm">
        <thead class="text-xs text-muted uppercase"><tr><th class="py-1">Channel</th><th>Sent</th><th>Opened</th></tr></thead>
        <tbody>
          <% { "text" => "text", "email" => "email", "whatsapp" => "whatsapp", "copy" => "link", "native" => "sheet" }.each do |sent, opened| %>
            <tr class="border-t border-line"><td class="py-1.5"><%= { "copy" => "copied link", "native" => "phone share sheet" }.fetch(sent, sent) %></td><td class="tabular-nums"><%= @share_channels[sent].to_i %></td><td class="tabular-nums"><%= @open_channels[opened].to_i %></td></tr>
          <% end %>
        </tbody>
      </table>
    </section>
  </div>

  <section class="mt-10">
    <h2 class="font-display text-xl font-bold">Outside links (checked nightly)</h2>
    <p class="mt-1 text-sm text-muted">Hidden from shoppers after <%= LinkCheck::MISSES_TO_HIDE %> definite misses (404/410) in a row. “Unsure” is usually a site blocking robots; it stays up.</p>
    <table class="mt-3 w-full text-left text-sm">
      <thead class="text-xs text-muted uppercase"><tr><th class="py-1">Result</th><th>Code</th><th>Link</th><th>Checked</th></tr></thead>
      <tbody>
        <% @links.each do |link| %>
          <tr class="border-t border-line">
            <td class="py-1.5 font-semibold <%= { "ok" => "text-teal-dark", "broken" => "text-red-700" }[link.result] %>"><%= link.result %><%= " (hidden)" if LinkCheck.broken?(link.url) %></td>
            <td class="tabular-nums"><%= link.status_code || link.error&.first(30) %></td>
            <td class="max-w-md truncate"><a href="<%= link.url %>" class="underline underline-offset-2" target="_blank" rel="noopener"><%= link.url.delete_prefix("https://") %></a></td>
            <td class="whitespace-nowrap text-muted"><%= time_ago_in_words(link.checked_at) %> ago</td>
          </tr>
        <% end %>
        <% if @links.empty? %><tr><td colspan="4" class="py-2 text-muted">Not checked yet: the first check runs tonight at 4am Central.</td></tr><% end %>
      </tbody>
    </table>
  </section>
</div>
