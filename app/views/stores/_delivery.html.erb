<%# "Get it delivered": the delivery apps' searches for JeeSauce. The app
    picks a nearby store that stocks it. Plain links, no affiliate codes. %>
<div class="<%= local_assigns[:class] %>">
  <p class="text-sm font-semibold">Or get it delivered</p>
  <ul class="mt-2 flex flex-wrap gap-2">
    <% Flavor.delivery.each do |app| %>
      <li>
        <a href="<%= app[:url] %>" target="_blank" rel="noopener"
           class="inline-flex items-center gap-2 rounded-full border border-line bg-white py-1.5 pr-4 pl-1.5 text-sm font-semibold shadow-sm transition hover:-translate-y-px hover:border-ink">
          <span class="grid size-7 place-items-center rounded-full font-display text-xs font-extrabold text-white" style="background: <%= app[:color] %>" aria-hidden="true"><%= app[:name].split.map(&:first).join %></span>
          <%= app[:name] %>
          <span aria-hidden="true" class="text-muted">↗</span>
        </a>
      </li>
    <% end %>
  </ul>
</div>
