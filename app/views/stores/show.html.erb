<% content_for :title, "#{@store.name}, #{@store.place_line}" %>
<% content_for :description, "#{@store.name} at #{[@store.address_line, @store.place_line].compact_blank.join(', ')} carries JeeSauce whipped almond hummus#{": #{@store.flavors.to_sentence}" if @store.flavors.any?}." %>
<% content_for :head do %>
  <%# One address for search engines whatever the ?flavor / ?shared; and a
      preview card when the link is texted or posted. %>
  <link rel="canonical" href="<%= store_url(@store) %>">
  <meta property="og:type" content="website">
  <meta property="og:title" content="JeeSauce at <%= @store.name %>">
  <meta property="og:description" content="Whipped almond hummus on the shelf at <%= [@store.address_line, @store.place_line].compact_blank.join(', ') %>.">
  <meta property="og:url" content="<%= store_url(@store) %>">
  <meta property="og:image" content="<%= image_url("og-card.png") %>">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
<% end %>

<div class="mx-auto max-w-6xl px-4 pt-6 sm:px-6" data-store="<%= @store.rep_id %>">
  <%= link_to "← All stores", finder_root_path, class: "text-sm text-muted hover:text-ink" %>

  <% if @shared %>
    <div class="mt-4 flex items-center gap-3 rounded-2xl bg-halo p-4" role="status">
      <span class="text-2xl" aria-hidden="true">♥</span>
      <p><strong class="font-display">A friend sent you this store.</strong> They think you'll love JeeSauce, and here's where to find it.</p>
    </div>
  <% end %>

  <div class="mt-4 grid gap-6 lg:grid-cols-2">
    <div>
      <% if @store.chain.present? && @store.chain != @store.name %>
        <p class="font-display text-sm font-bold tracking-wide text-teal-dark uppercase"><%= @store.chain %></p>
      <% end %>
      <h1 class="mt-1 font-display text-3xl leading-tight font-extrabold tracking-tight sm:text-4xl"><%= @store.name %></h1>
      <address class="mt-3 text-lg not-italic"><%= @store.address_line %><br><%= @store.place_line %></address>
      <% if (fresh = freshness_line(@store)) %>
        <p class="mt-2 text-sm font-semibold text-[#1f7a45]"><%= fresh_dot %><%= fresh %> · <a href="#found" class="underline underline-offset-2">seen it?</a></p>
      <% end %>
      <a href="<%= @store.directions_url %>" target="_blank" rel="noopener" class="mt-5 inline-block rounded-full bg-ink px-6 py-3 font-semibold text-white hover:bg-teal-dark">Get directions</a>
      <%= render "stores/share", store: @store %>
      <%= render "stores/love_counter", class: "mt-4" %>
      <% if @store_shares.positive? %>
        <p class="mt-2 text-sm text-muted">♥ Shared <%= pluralize(@store_shares, "time") %> from this store.</p>
      <% end %>

      <h2 id="buy" class="mt-8 scroll-mt-4 font-display text-xl font-bold">Flavors on this shelf</h2>
      <% if @store.flavors.any? %>
        <ul class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3">
          <% @store.sorted_flavors.each do |name| %>
            <% flavor = Flavor.named(name) %>
            <% url = Flavor.chain_link(@store.shop_chain, name) %>
            <li class="<%= class_names("flex flex-col items-center gap-2 rounded-2xl bg-white p-3 text-center shadow-sm", "ring-2 ring-ink": @flavor&.name == name) %>">
              <% if flavor %><%= lid_icon flavor, size: 72 %><% end %>
              <span class="text-sm font-semibold leading-tight"><%= name %></span>
              <% if url %>
                <a href="<%= url %>" target="_blank" rel="noopener" class="w-full rounded-full bg-halo px-3 py-1.5 text-xs font-semibold text-ink hover:bg-[#e0c510]">Buy at <%= Flavor.chain_label(@store.shop_chain) %></a>
              <% elsif flavor %>
                <a href="<%= dtc_url(flavor, spot: "store-flavor") %>" class="w-full rounded-full border border-ink px-3 py-1.5 text-xs font-semibold hover:bg-ink hover:text-white">Order online</a>
              <% end %>
            </li>
          <% end %>
        </ul>
        <p class="mt-3 text-sm text-muted">Shelves change. If a flavor's missing, ask the store, or <a href="<%= dtc_url(spot: "store-page") %>" class="underline underline-offset-2">order it online</a>.</p>
      <% else %>
        <p class="mt-2 text-muted">We don't know which flavors this store stocks yet, so call ahead. Every flavor also <a href="<%= dtc_url(spot: "store-page") %>" class="underline underline-offset-2">ships to your door</a>.</p>
      <% end %>
      <%= render "stores/found" %>
      <%= render "stores/ships", flavor: @flavor, spot: "store-page-tile", class: "mt-6" %>
      <%= render "stores/retailers", class: "mt-6" %>
      <%= render "stores/delivery", class: "mt-4" %>
      <% if @flavor && @store.flavor_state(@flavor) == :doesnt %>
        <p class="mt-4 rounded-2xl bg-white p-4 text-sm">
          This store doesn't list <%= @flavor.name %>.
          <%= link_to "Find a store that does", flavor_filter_path(@flavor), class: "font-semibold underline underline-offset-2" %>
          or <a href="<%= dtc_url(@flavor, spot: "store-missing-flavor") %>" class="font-semibold underline underline-offset-2">order it online</a>.
        </p>
        <%= render "stores/ask", flavor: @flavor, store: @store, class: "mt-4" %>
      <% end %>
    </div>

    <% if maps_key && @store.located? %>
      <div class="h-72 overflow-hidden rounded-2xl bg-line sm:h-96"
           data-controller="map"
           data-map-stores-value="<%= [{ lat: @store.lat.to_f, lng: @store.lng.to_f, name: @store.name }].to_json %>"
           data-map-zoom-value="15" role="region" aria-label="Map"></div>
    <% end %>
  </div>

  <% if @nearby.any? %>
    <h2 class="mt-12 font-display text-2xl font-bold">More stores nearby</h2>
    <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      <%= render partial: "stores/store", collection: @nearby %>
    </ul>
  <% end %>
</div>
