<%# "Ask your store" (item 3): when there's no store nearby, or none with the
    chosen flavor, or this store doesn't list it. The shopper copies our
    request (flavors and UPCs) and pastes it into their chain's
    product-request page, or shows it to the manager. Each copy or chain tap
    is counted, by chain and coarse place only (Ask). store: this store's
    page, to ask that store; otherwise any store near the search. %>
<% flavor = local_assigns[:flavor] %>
<% store = local_assigns[:store] %>
<% text = Retailer.request_text(flavor) %>
<% requests = Retailer.requests %>
<% mine = store && requests.find { |_, r| r[:name] == Flavor.chain_label(store.chain) }&.first %>
<section class="<%= class_names("rounded-2xl border-2 border-dashed border-ink/30 bg-white p-4 sm:p-5", local_assigns[:class]) %>"
         data-controller="ask" data-ask-url-value="<%= asks_path %>"
         data-ask-place-value="<%= { zip: @query.to_s[/\A\d{5}/] || store&.zip, lat: @lat || store&.lat&.to_f, lng: @lng || store&.lng&.to_f, flavor: flavor&.slug }.compact.to_json %>">
  <h2 class="font-display text-xl font-bold">
    <%= store ? "Ask this store for #{flavor&.name || "JeeSauce"}" : "Not near you yet? Ask your store." %>
  </h2>
  <p class="mt-1 text-sm text-muted">Stores stock what their shoppers ask for. It takes a minute: copy this, then send it to your store, or show it to the manager next time you're in.</p>
  <textarea readonly rows="4" data-ask-target="text" data-action="focus->ask#select"
            class="mt-3 w-full resize-none rounded-xl border border-line bg-cream p-3 text-sm" aria-label="Your request"><%= text %></textarea>
  <div class="mt-2 flex flex-wrap items-center gap-2">
    <button type="button" data-action="ask#copy" data-ask-target="copy" class="rounded-full bg-ink px-4 py-2 text-sm font-semibold text-white hover:bg-teal-dark">Copy my request</button>
    <span class="text-sm text-muted">then send it to:</span>
    <% requests.each do |key, r| %>
      <a href="<%= r[:url] %>" target="_blank" rel="noopener" title="<%= r[:how] %>"
         data-action="ask#record" data-ask-chain-param="<%= key %>"
         class="<%= class_names("rounded-full border px-3 py-1.5 text-sm font-semibold hover:bg-ink hover:text-white", key == mine ? "border-ink bg-halo" : "border-ink bg-white") %>"><%= r[:name] %> ↗</a>
    <% end %>
  </div>
  <% if mine %><p class="mt-2 text-xs text-muted"><%= requests[mine][:how] %></p><% end %>
  <p class="mt-2 hidden text-xs font-semibold text-teal-dark" role="status" data-ask-target="thanks">Copied. Thanks for asking: every request helps us get on more shelves.</p>
</section>
