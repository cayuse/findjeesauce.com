# Rails defaults
/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep

# Secrets: never in git. master.key lives in /home/sauce/secrets/findjeesauce/
/config/master.key
/config/*.key
.env
.env.*
!.env.example

/coverage

# Ignore key files for decrypting credentials and more.
/config/*.key

