# Rails defaults
/.bundle
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep
/storage/*
!/storage/.keep
/public/assets
/app/assets/builds/*
!/app/assets/builds/.keep
/coverage
/spec/examples.txt
/.byebug_history
/node_modules

# Secrets: never in git. They live in /home/sauce/secrets/findjeesauce/;
# .kamal/secrets* are only lookups into that tree and ARE committed.
/config/master.key
/config/*.key
/config/credentials/*.key
.env
.env.*
!.env.example
*.pem

