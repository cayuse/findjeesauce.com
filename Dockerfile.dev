# syntax=docker/dockerfile:1
# Development image: toolchain + dev/test gems, source bind-mounted at runtime
# (compose.yaml). Production builds use ./Dockerfile (Kamal). Same shape as
# rep's; no Node (importmap + tailwindcss-rails standalone binary).
ARG RUBY_VERSION=3.4.10
FROM docker.io/library/ruby:${RUBY_VERSION}-slim

# Match the container user to the HOST user so bind-mounted files are yours.
# Build ONLY via bin/dev-build (bakes your uid); a wrong uid silently breaks
# repo writes and db/structure.sql dumps — rep learned this the hard way.
ARG UID=1000
ARG GID=1000

RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential git curl pkg-config libpq-dev libyaml-dev libvips postgresql-client && \
    rm -rf /var/lib/apt/lists/* /var/cache/apt/archives

RUN (getent group ${GID} || groupadd -g ${GID} app) && \
    (getent passwd ${UID} || useradd -u ${UID} -g ${GID} -s /bin/bash app) && \
    mkdir -p /home/app && chown ${UID}:${GID} /home/app

ENV BUNDLE_PATH=/usr/local/bundle \
    GEM_HOME=/usr/local/bundle \
    HOME=/home/app \
    RAILS_ENV=development
RUN mkdir -p ${BUNDLE_PATH} && chown -R ${UID}:${GID} ${BUNDLE_PATH}

WORKDIR /rails
RUN chown ${UID}:${GID} /rails

USER ${UID}:${GID}

EXPOSE 3000
CMD ["./bin/dev"]
