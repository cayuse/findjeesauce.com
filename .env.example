# Dev only (compose.yaml). Copy to .env. Real secrets live in /home/sauce/secrets/findjeesauce/.
POSTGRES_USER=findjeesauce
POSTGRES_PASSWORD=findjeesauce-dev
POSTGRES_DB=findjeesauce_development
DATABASE_HOST=db
DATABASE_USERNAME=findjeesauce
DATABASE_PASSWORD=findjeesauce-dev

# Rep's store feed. Dev points at staging rep; leave the token blank to use the
# recorded fixture (bin/rails stores:sync FIXTURE=1).
REP_API_URL=https://sauce.cavaforge.net
REP_API_TOKEN=

# Google Maps JavaScript API browser key (referrer-restricted). Blank = list-only.
GOOGLE_MAPS_BROWSER_API_KEY=
